addEventListener("message",e=>{if(parent===window||e.source!==parent)return;const d=e.data;if(d&&d.st3d=="load"&&okNodes(d.nodes)){d.nodes.forEach(n=>{n.tags=Array.isArray(n.tags)?n.tags:[]});nodes=d.nodes;reidx();sel=null;hist=[];redo=[];save();data();draw()}});
new ResizeObserver(draw).observe(cv);sync();
const mu=gl.getParameter(gl.MAX_FRAGMENT_UNIFORM_VECTORS);if(mu<MAXN*4+44)msg.textContent="Warning: this GPU allows only "+mu+" uniform vectors (need ~"+(MAXN*4+40)+"). "+msg.textContent;
}
</script><script>
/* ===== ST SHELL MODULE (added v0.5.0): Live = clean viewport, Build = editor UI swapped in. Starts in Live. ===== */
(function(){const $=id=>document.getElementById(id),b=document.body;
 const mk=(id,t)=>{const e=document.createElement("button");e.id=id;e.className="orb gl";e.textContent=t;b.appendChild(e);return e};
 const mo=mk("mode","\u25B6"),sb=mk("sbtn","\u2699");
 b.appendChild($("tb"));$("tb").classList.add("gl");$("ui").classList.add("gl");
 function say(t){const m=$("msg");m.textContent=t;clearTimeout(say.t);say.t=setTimeout(()=>{if(m.textContent==t)m.textContent=""},1400)}
 function set(build){b.classList.toggle("build",build);b.classList.remove("sl");sb.classList.remove("on");mo.textContent=build?"\uD83D\uDD28":"\u25B6";mo.classList.toggle("on",build);if(window.ST3D)ST3D.setLive(!build);say(build?"Build":"Live")}
 const emb=window.parent!==window;
 mo.onclick=()=>{if(emb&&b.classList.contains("build")){parent.postMessage({st3d:"exit",nodes:ST3D.getNodes(),changed:ST3D.changed()},"*");return}set(!b.classList.contains("build"))};
 if(emb)set(true);
 sb.onclick=()=>{const o=b.classList.toggle("sl");sb.classList.toggle("on",o)};
 $("tbj").addEventListener("click",()=>{b.classList.add("sl");sb.classList.add("on")});
 $("jx").addEventListener("click",()=>{b.classList.remove("sl");sb.classList.remove("on")});
})();
</script></body></html>
