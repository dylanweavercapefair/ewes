<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ST3D editor (Stage 3)</title>
<style>
:root{--u:1;--bg:#f3f0e8;--fg:#1d2420;--pn:rgba(255,255,255,.92);--ac:#2f8f6a;--ln:#c9c4b8;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121a16;--fg:#e4ece7;--pn:rgba(28,39,33,.92);--ln:#384a41}}
:root[data-theme="dark"]{--bg:#121a16;--fg:#e4ece7;--pn:rgba(28,39,33,.92);--ln:#384a41}
*{box-sizing:border-box}html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--fg);font:calc(14px*var(--u))/1.3 system-ui,-apple-system,sans-serif;display:flex;flex-direction:column}
#v{flex:1;min-height:0;position:relative}
canvas{width:100%;height:100%;display:block;touch-action:none}
#ui{padding:8px 10px;display:grid;grid-template-columns:repeat(auto-fit,minmax(calc(220px*var(--u)),1fr));gap:4px 14px;background:var(--pn);border-top:1px solid var(--ln)}
label{display:flex;align-items:center;gap:8px;min-height:calc(44px*var(--u))}
label span{min-width:calc(96px*var(--u))}label output{min-width:calc(38px*var(--u));text-align:right}
input[type=range]{flex:1;height:calc(44px*var(--u))}
button{min-height:calc(44px*var(--u));min-width:44px;padding:0 14px;border:1px solid var(--ln);border-radius:10px;background:var(--pn);color:var(--fg);font:inherit}
button.on{background:var(--ac);color:#fff;border-color:var(--ac)}
#ov{position:absolute;left:0;top:0;pointer-events:none}
#tb{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px}
#jb{grid-column:1/-1;display:none}#jb.s{display:block}#jb textarea{width:100%;height:calc(90px*var(--u));font:11px monospace;background:var(--bg);color:var(--fg);border:1px solid var(--ln);border-radius:8px}
#msg{position:absolute;left:10px;top:8px;max-width:calc(100% - 20px);font-size:calc(12px*var(--u));padding:4px 8px;border-radius:8px;background:var(--pn);pointer-events:none}

/* ===== ST SHELL (overlay): outer margin = orbs only, inner margin = sheets only, everything else = viewport. Light glass. ===== */
:root{--m:12px;--mi:56px;--gl:rgba(128,140,134,.30);--l:calc(env(safe-area-inset-left,0px) + var(--m));--r:calc(env(safe-area-inset-right,0px) + var(--m));--b:calc(env(safe-area-inset-bottom,0px) + var(--m));--t:calc(env(safe-area-inset-top,0px) + var(--m))}
html,body{overflow:hidden}body{display:block}
#v{position:fixed;inset:0;flex:none}
.gl{background:var(--gl)!important;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.25)}
.orb{position:fixed;width:48px;height:48px;min-width:48px;padding:0;border-radius:50%;font-size:20px;z-index:5;display:flex;align-items:center;justify-content:center}
.orb.on{background:var(--ac)!important;color:#fff}
#mode{left:var(--l);bottom:var(--b)}#sbtn{right:var(--r);bottom:var(--b);display:none}
body.build #sbtn{display:flex}
#msg{left:var(--l);top:var(--t);background:var(--gl);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
#tb{position:fixed;left:calc(var(--l) + var(--mi));right:calc(var(--r) + var(--mi));bottom:var(--b);height:56px;padding:5px;border-radius:16px;display:none;flex-wrap:nowrap;overflow-x:auto;overflow-y:hidden;gap:6px;z-index:5;touch-action:pan-x;-webkit-overflow-scrolling:touch}
#tb button{flex:0 0 auto;background:transparent;border-color:transparent}#tb button.on{background:var(--ac);border-color:var(--ac)}
#ui{position:fixed;left:calc(var(--l) + var(--mi));right:calc(var(--r) + var(--mi));bottom:calc(var(--b) + 64px);max-height:40%;overflow:auto;display:none;border-radius:16px;z-index:4}
body.build #tb{display:flex}body.build.sl #ui{display:grid}
</style></head><body>
<div id="v"><canvas id="c"></canvas><canvas id="ov"></canvas><div id="msg"></div></div>
<div id="ui">
<label><span>Smoothness</span><input id="k" type="range" min="0" max="40" value="16"><output id="ko"></output></label>
<label><span>Leg thickness</span><input id="lg" type="range" min="50" max="180" value="100"><output id="lo"></output></label>
<label><span>Body width</span><input id="bw" type="range" min="70" max="140" value="100"><output id="bo"></output></label>
<label><span>UI scale</span><input id="us" type="range" min="100" max="160" value="100"><output id="uo"></output></label>
<div id="tb"><button id="tbt">Move</button><button id="tbs">+ Ball</button><button id="tbh">+ Hole</button><button id="tbl">Slice</button><button id="tbc">Copy</button><button id="tbd">Delete</button><button id="tba">Attach</button><button id="tbe">Detach</button><button id="tbk">Link</button><button id="tbu">↶</button><button id="tbr">↷</button><button id="tbm">Mirror</button><button id="tbp">Pair</button><button id="tbf" class="on">Floor</button><button id="tbn">Snap 0.05</button><button id="tbj">JSON</button></div>
<label><span>Size</span><input id="sz" type="range" min="3" max="70" value="12" disabled><output id="zo">–</output></label>
<div id="jb"><textarea id="jt" spellcheck="false"></textarea><div style="display:flex;gap:8px;margin-top:6px"><button id="jl">Load from box</button><button id="jf">Factory</button><button id="jx">Close</button></div></div>
<div style="display:flex;gap:8px;flex-wrap:wrap"><button id="vf" class="on">Free</button><button id="vi">Iso</button><button id="vo">Front</button><button id="vs">Side</button><button id="vt">Top</button><button id="rs">Reset</button></div>
</div>
