<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pony nodes: smooth blend demo</title>
<style>
:root{--bg:#f3f0e8;--fg:#1d2420;--pn:rgba(255,255,255,.92);--ac:#2f8f6a;--ln:#c9c4b8;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121a16;--fg:#e4ece7;--pn:rgba(28,39,33,.92);--ln:#384a41}}
:root[data-theme="dark"]{--bg:#121a16;--fg:#e4ece7;--pn:rgba(28,39,33,.92);--ln:#384a41}
*{box-sizing:border-box}html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--fg);font:14px/1.3 system-ui,-apple-system,sans-serif;display:flex;flex-direction:column}
#v{flex:1;min-height:0;position:relative}
canvas{width:100%;height:100%;display:block;touch-action:none}
#ui{padding:8px 10px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:4px 14px;background:var(--pn);border-top:1px solid var(--ln)}
label{display:flex;align-items:center;gap:8px;min-height:44px}
label span{min-width:96px}label output{min-width:38px;text-align:right}
input[type=range]{flex:1;height:44px}
button{min-height:44px;min-width:44px;padding:0 14px;border:1px solid var(--ln);border-radius:10px;background:var(--pn);color:var(--fg);font:inherit}
button.on{background:var(--ac);color:#fff;border-color:var(--ac)}
#msg{position:absolute;left:10px;top:8px;font-size:12px;opacity:.8;pointer-events:none}
</style></head><body>
<div id="v"><canvas id="c"></canvas><div id="msg">drag = orbit · pinch = zoom</div></div>
<div id="ui">
<label><span>Smoothness</span><input id="k" type="range" min="0" max="40" value="16"><output id="ko"></output></label>
<label><span>Leg thickness</span><input id="lg" type="range" min="50" max="180" value="100"><output id="lo"></output></label>
<label><span>Body width</span><input id="bw" type="range" min="70" max="140" value="100"><output id="bo"></output></label>
<div style="display:flex;gap:8px"><button id="pr">Iso / Persp</button><button id="rs">Reset</button></div>
</div>
<script>
const RAW=[["head",.45,0,1.85,.539,"chest"],["muzzle",.74,0,1.62,.22,"head",1.1,.95,.75],["chest",.2,0,1,.34,""],["rear",-.165,-.03,1.024,.36,"chest"],["pelvis",-.26,0,.88,.2,"rear",1,1.15,.75]];
[["FL1",.22,.121,.95,.116,"chest"],["FL2",.226,.154,.55,.121,"FL1"],["FL3",.27,.166,.25,.132,"FL2"],["FL4",.28,.175,.13,.13,"FL3",1.08,1.08,.75],["BL0",-.257,.078,.95,.245,"rear"],["BL1",-.298,.193,.674,.16,"BL0",1,.898,1],["BL2",-.477,.205,.66,.12,"BL1"],["BL3",-.413,.228,.257,.15,"BL2",1,.941,1],["BL4",-.393,.221,.145,.145,"BL3",1.08,1.08,.75]]
.forEach(a=>{RAW.push(a);const b=a.slice();b[0]=a[0].replace("L","R");b[5]=a[5].replace("L","R");b[2]=a[0]=="BL0"?-.138:-a[2];RAW.push(b)});
const S=RAW.map(a=>({n:a[0],x:a[1],y:a[2],z:a[3],r:a[4],p:a[5],sq:a[6]?[a[6],a[7],a[8]]:[1,1,1]})),by=Object.fromEntries(S.map(s=>[s.n,s]));
const NECK={A:[.55,0,1.95],B:[.25,0,1.12],ra:.2,rb:.15};
const VS="attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}";
const FS=`precision highp float;
uniform vec2 uRes;uniform vec3 uT,uF,uR,uU;uniform float uO,uZ,uK;uniform int uN,uL;uniform vec4 uH,uM;
uniform vec4 uC[24],uRd[24],uLA[24],uLB[24],uLR[24];
float d2(vec3 v){return dot(v,v);}
float rc(vec3 p,vec3 a,vec3 b,float r1,float r2){vec3 ba=b-a;float l2=dot(ba,ba),rr=r1-r2,a2=l2-rr*rr,il=1./l2;vec3 pa=p-a;float y=dot(pa,ba),z=y-l2,x2=d2(pa*l2-ba*y),y2=y*y*l2,z2=z*z*l2,k=sign(rr)*rr*rr*x2;
 if(sign(z)*a2*z2>k)return sqrt(x2+z2)*il-r2;if(sign(y)*a2*y2<k)return sqrt(x2+y2)*il-r1;return(sqrt(x2*a2*il)+y*rr)*il-r1;}
float el(vec3 p,vec3 r){float k0=length(p/r),k1=length(p/(r*r));return k1<1e-6?-min(r.x,min(r.y,r.z)):k0*(k0-1.)/k1;}
float sm(float a,float b,float k){float h=max(k-abs(a-b),0.)/k;return min(a,b)-h*h*k*.25;}
float map(vec3 p){float d=1e5,k=max(uK,.001);
 for(int i=0;i<24;i++){if(i>=uN)break;d=sm(d,el(p-uC[i].xyz,uRd[i].xyz),k);}
 for(int i=0;i<24;i++){if(i>=uL)break;d=sm(d,rc(p,uLA[i].xyz,uLB[i].xyz,uLR[i].x,uLR[i].y),k);}return d;}
vec3 nr(vec3 p){vec2 e=vec2(.003,-.003);return normalize(e.xyy*map(p+e.xyy)+e.yyx*map(p+e.yyx)+e.yxy*map(p+e.yxy)+e.xxx*map(p+e.xxx));}
void main(){vec2 uv=(gl_FragCoord.xy-.5*uRes)/uRes.y;vec3 ro,rd;
 if(uO>.5){rd=uF;ro=uT-uF*9.+(uR*uv.x+uU*uv.y)*uZ;}else{rd=normalize(uF+(uR*uv.x+uU*uv.y)*.8);ro=uT-uF*uZ*1.9;}
 float t=0.,d=1.;bool hit=false;for(int i=0;i<90;i++){d=map(ro+rd*t);if(d<.0025){hit=true;break;}t+=d;if(t>24.)break;}
 vec3 col=vec3(.09,.12,.10);float tg=-1.;if(rd.z<-1e-3){tg=-ro.z/rd.z;}
 vec3 L=normalize(vec3(.35,.45,.85));
 if(hit&&(tg<0.||t<tg)){vec3 p=ro+rd*t,n=nr(p);float dif=clamp(dot(n,L),0.,1.),rim=pow(1.-clamp(dot(n,-rd),0.,1.),2.5),ao=clamp(map(p+n*.1)/.1,0.,1.);
  float h=min(length(p-uH.xyz)-uH.w,length(p-uM.xyz)-uM.w);vec3 base=mix(vec3(.92,.62,.72),vec3(.86,.72,.58),smoothstep(0.,.08,h));
  col=base*(.28+.72*dif)*(.55+.45*ao)+rim*.18;}
 else if(tg>0.){vec3 g=ro+rd*tg;float sh=smoothstep(0.,.7,map(vec3(g.xy,.0)));vec2 f=abs(fract(g.xy/.5)-.5);float ln=1.-smoothstep(0.,.03,min(f.x,f.y));
  col=mix(vec3(.12,.17,.14),vec3(.32,.42,.36),ln*.6)*(.45+.55*sh);col*=1.-smoothstep(5.,12.,length(g.xy-uT.xy));}
 gl_FragColor=vec4(pow(col,vec3(.4545)),1.);}`;
const cv=document.getElementById("c"),gl=cv.getContext("webgl",{antialias:false});
function sh(t,s){const o=gl.createShader(t);gl.shaderSource(o,s);gl.compileShader(o);if(!gl.getShaderParameter(o,gl.COMPILE_STATUS))document.getElementById("msg").textContent="shader error: "+gl.getShaderInfoLog(o);return o}
const pg=gl.createProgram();gl.attachShader(pg,sh(gl.VERTEX_SHADER,VS));gl.attachShader(pg,sh(gl.FRAGMENT_SHADER,FS));gl.linkProgram(pg);gl.useProgram(pg);
const bf=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,bf);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,3,-1,-1,3]),gl.STATIC_DRAW);const al=gl.getAttribLocation(pg,"a");gl.enableVertexAttribArray(al);gl.vertexAttribPointer(al,2,gl.FLOAT,false,0,0);
const U=n=>gl.getUniformLocation(pg,n);
let yaw=45,pitch=28,zoom=3.6,ortho=1,q=.8,K=.16,LG=1,BW=1;
const leg=n=>/^[FB][LR]\d$/.test(n),body=n=>/^(chest|rear|pelvis)$/.test(n),D=Math.PI/180;
function data(){const C=[],Rd=[],LA=[],LB=[],LR=[];const m=s=>leg(s.n)?LG:1;
 S.forEach(s=>{const f=m(s),w=body(s.n)?BW:1;C.push(s.x,s.y,s.z,0);Rd.push(s.r*s.sq[0]*f,s.r*s.sq[1]*f*w,s.r*s.sq[2]*f,0)});
 const lk=(a,b,r1,r2)=>{const l2=(a[0]-b[0])**2+(a[1]-b[1])**2+(a[2]-b[2])**2;if((r1-r2)**2>=l2*.95)return;LA.push(...a,0);LB.push(...b,0);LR.push(r1,r2,0,0)};
 S.forEach(s=>{if(s.p&&s.n!="head"){const a=by[s.p];lk([a.x,a.y,a.z],[s.x,s.y,s.z],a.r*m(a)*(body(a.n)?BW:1),s.r*m(s)*(body(s.n)?BW:1))}});
 lk(NECK.A,NECK.B,NECK.ra,NECK.rb);
 const pad=(a,n)=>{const o=new Float32Array(n*4);o.set(a);return o};
 gl.uniform4fv(U("uC[0]"),pad(C,24));gl.uniform4fv(U("uRd[0]"),pad(Rd,24));gl.uniform4fv(U("uLA[0]"),pad(LA,24));gl.uniform4fv(U("uLB[0]"),pad(LB,24));gl.uniform4fv(U("uLR[0]"),pad(LR,24));
 gl.uniform1i(U("uN"),S.length);gl.uniform1i(U("uL"),LA.length/4);gl.uniform4f(U("uH"),by.head.x,by.head.y,by.head.z,by.head.r);gl.uniform4f(U("uM"),by.muzzle.x,by.muzzle.y,by.muzzle.z,by.muzzle.r*.9)}
function draw(){const dpr=devicePixelRatio||1,W=Math.max(2,Math.floor(cv.clientWidth*dpr*q)),H=Math.max(2,Math.floor(cv.clientHeight*dpr*q));if(cv.width!=W||cv.height!=H){cv.width=W;cv.height=H}
 gl.viewport(0,0,W,H);const y=yaw*D,p=pitch*D,F=[-Math.cos(p)*Math.cos(y),-Math.cos(p)*Math.sin(y),-Math.sin(p)];
 const up=[0,0,1],r=norm(cross(up,F)),u=cross(F,r);
 gl.uniform2f(U("uRes"),W,H);gl.uniform3f(U("uT"),0,0,1.1);gl.uniform3fv(U("uF"),F);gl.uniform3fv(U("uR"),r);gl.uniform3fv(U("uU"),u);gl.uniform1f(U("uO"),ortho);gl.uniform1f(U("uZ"),zoom);gl.uniform1f(U("uK"),K);gl.drawArrays(gl.TRIANGLES,0,3)}
function cross(a,b){return[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]]}
function norm(a){const l=Math.hypot(...a)||1;return a.map(v=>v/l)}
const $=id=>document.getElementById(id),cl=(v,l,h)=>Math.min(h,Math.max(l,v));
function sync(){K=$("k").value/100;LG=$("lg").value/100;BW=$("bw").value/100;$("ko").textContent=K.toFixed(2);$("lo").textContent=LG.toFixed(2)+"×";$("bo").textContent=BW.toFixed(2)+"×";data();draw()}
["k","lg","bw"].forEach(i=>$(i).oninput=sync);
$("pr").onclick=()=>{ortho^=1;draw()};$("rs").onclick=()=>{yaw=45;pitch=28;zoom=3.6;draw()};
const ptr=new Map(),pn=()=>{if(ptr.size<2)return 0;const[a,b]=[...ptr.values()];return Math.hypot(a[0]-b[0],a[1]-b[1])};let pd=0;
cv.addEventListener("pointerdown",e=>{cv.setPointerCapture(e.pointerId);ptr.set(e.pointerId,[e.clientX,e.clientY]);pd=pn();q=.45});
cv.addEventListener("pointermove",e=>{const o=ptr.get(e.pointerId);if(!o)return;ptr.set(e.pointerId,[e.clientX,e.clientY]);if(ptr.size==2){const d=pn();if(pd)zoom=cl(zoom*pd/d,1.2,9);pd=d}else{yaw=(yaw-(e.clientX-o[0])*.5+360)%360;pitch=cl(pitch+(e.clientY-o[1])*.3,3,85)}draw()});
const up=e=>{ptr.delete(e.pointerId);pd=0;if(!ptr.size){q=.8;draw()}};cv.addEventListener("pointerup",up);cv.addEventListener("pointercancel",up);
new ResizeObserver(draw).observe(cv);sync();
</script></body></html>
